      "source": [
        "import os, json, itertools\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import cv2\n",
        "from scipy.stats import spearmanr\n",
        "import matplotlib.pyplot as plt\n",
        "from sklearn.metrics import average_precision_score\n",
        "\n",
        "CKPT_TAG   = \"best\"                     # set \"epoch25\" to re-run the confirmatory arm\n",
        "CAM_ROOT   = os.path.join(XRV_SAVE_DIR, f\"gradcam_npy_{CKPT_TAG}_fixedrelu\")\n",
        "OUT_DIR    = os.path.join(XRV_SAVE_DIR, f\"gradcam_metrics_{CKPT_TAG}_withGBP\")\n",
        "AGG_DIR    = os.path.join(OUT_DIR, \"_aggregate\")\n",
        "os.makedirs(AGG_DIR, exist_ok=True)\n",
        "\n",
        "SCORE_SIZE = 1024\n",
        "CAM_NATIVE = 7           # raw map resolution; agreement is computed here\n",
        "N_BOOT     = 1000\n",
        "BOOT_SEED  = 42\n",
        "\n",
        "labels_df = pd.read_csv(\"/content/rsna-pneumonia-dataset-npy/stage_2_train_labels.csv\")\n",
        "\n",
        "\n",
        "#helpers\n",
        "def load_raw(seed, pid):\n",
        "    \"\"\"Load raw 7x7 CAM, apply ReLU, then max-normalize to [0,1].\"\"\"\n",
        "    f = os.path.join(CAM_ROOT, f\"seed_{seed}\", f\"{pid}.npy\")\n",
        "    if not os.path.exists(f):\n",
        "        return None\n",
        "    cam = np.load(f).astype(np.float32)\n",
        "    # §5 amendment: rectify CAM before normalization\n",
        "    cam = np.maximum(cam, 0)\n",
        "    # Max-normalize the non-negative CAM to [0,1]\n",
        "    max_cam = cam.max()\n",
        "    if max_cam > 0:\n",
        "        cam = cam / max_cam\n",
        "    else:\n",
        "        cam = np.zeros_like(cam)\n",
        "\n",
        "    return cam\n",
        "\n",
        "\n",
        "def upsample(cam):\n",
        "    return cv2.resize(cam, (SCORE_SIZE, SCORE_SIZE), interpolation=cv2.INTER_LINEAR)\n",
        "\n",
        "\n",
        "def box_mask(pid):\n",
        "    r = labels_df[(labels_df.patientId == pid) & (labels_df.Target == 1)]\n",
        "    r = r.dropna(subset=[\"x\", \"y\", \"width\", \"height\"])\n",
        "    if r.empty:\n",
        "        return None\n",
        "    m = np.zeros((SCORE_SIZE, SCORE_SIZE), np.uint8)\n",
        "    for _, b in r.iterrows():\n",
        "        x0, y0 = int(b.x), int(b.y)\n",
        "        x1, y1 = int(b.x + b.width), int(b.y + b.height)\n",
        "        m[max(y0, 0):min(y1, SCORE_SIZE), max(x0, 0):min(x1, SCORE_SIZE)] = 1\n",
        "    return m if m.sum() else None\n",
        "\n",
        "\n",
        "def auprc(mask_flat, map_flat):\n",
        "    if mask_flat.sum() == 0:\n",
        "        return np.nan\n",
        "    return float(average_precision_score(mask_flat, map_flat))\n",
        "\n",
        "\n",
        "# whats on the disk\n",
        "pred_paths = {s: os.path.join(CAM_ROOT, f\"seed_{s}\", \"preds.csv\")\n",
        "              for s in HPARAMS2[\"seeds\"]}\n",
        "pred_paths = {s: p for s, p in pred_paths.items() if os.path.exists(p)}\n",
        "SEEDS = sorted(pred_paths.keys())\n",
        "\n",
        "preds = pd.concat([pd.read_csv(p) for p in pred_paths.values()])\n",
        "patients = sorted(preds.patientId.unique())\n",
        "masks = {pid: box_mask(pid) for pid in patients}\n",
        "masks = {k: v for k, v in masks.items() if v is not None}\n",
        "\n",
        "print(f\"[{CKPT_TAG}] {len(SEEDS)} seeds, {len(patients)} patients, \"\n",
        "      f\"{len(masks)} with usable boxes\")\n",
        "if len(SEEDS) < len(HPARAMS2[\"seeds\"]):\n",
        "    print(f\"  [!] missing: {sorted(set(HPARAMS2['seeds']) - set(SEEDS))}\")\n",
        "\n",
        "\n",
        "# score every (seed, image)\n",
        "rows, zero_maps = [], []\n",
        "\n",
        "for i, (pid, gt) in enumerate(masks.items(), 1):\n",
        "    gt_flat = gt.reshape(-1)\n",
        "    prevalence = float(gt.mean())          # exact AUPRC of a random ranker\n",
        "    for s in SEEDS:\n",
        "        raw = load_raw(s, pid)\n",
        "        if raw is None:\n",
        "            continue\n",
        "        if raw.max() <= 0:\n",
        "            zero_maps.append({\"seed\": s, \"patientId\": pid})\n",
        "            rows.append({\"seed\": s, \"patientId\": pid, \"auprc\": 0.0,\n",
        "                         \"pointing_hit\": 0, \"prevalence\": prevalence,\n",
        "                         \"all_zero\": True})\n",
        "            continue\n",
        "        m = upsample(raw)\n",
        "        py, px = np.unravel_index(np.argmax(m), m.shape)\n",
        "        rows.append({\"seed\": s, \"patientId\": pid,\n",
        "                     \"auprc\": auprc(gt_flat, m.reshape(-1)),\n",
        "                     \"pointing_hit\": int(gt[py, px] == 1),\n",
        "                     \"prevalence\": prevalence,\n",
        "                     \"all_zero\": False})\n",
        "    if i % 50 == 0:\n",
        "        print(f\"  {i}/{len(masks)} images scored\")\n",
        "\n",
        "sdf = pd.DataFrame(rows)\n",
        "sdf.to_csv(os.path.join(AGG_DIR, \"per_image_per_seed_scores.csv\"), index=False)\n",
        "print(f\"\\nscored {len(sdf)} (seed, image) pairs; {len(zero_maps)} all-zero maps\")\n",
        "\n",
        "\n",
        "# per seed output\n",
        "per_seed_rows = []\n",
        "\n",
        "for seed in SEEDS:\n",
        "    sub = sdf[sdf.seed == seed]\n",
        "    preds_s = pd.read_csv(pred_paths[seed])[[\"patientId\", \"pred_prob\"]]\n",
        "    merged = sub.merge(preds_s, on=\"patientId\", how=\"left\")\n",
        "\n",
        "    seed_out = os.path.join(OUT_DIR, f\"seed_{seed}\")\n",
        "    os.makedirs(seed_out, exist_ok=True)\n",
        "    merged.to_csv(os.path.join(seed_out, \"localization.csv\"), index=False)\n",
        "\n",
        "    pos = merged[merged.pred_prob >= 0.5]\n",
        "    s_sum = {\n",
        "        \"seed\": seed, \"checkpoint\": CKPT_TAG, \"n_images\": len(merged),\n",
        "        \"auprc_mean\": float(merged.auprc.mean()),\n",
        "        \"auprc_sd_across_images\": float(merged.auprc.std()),\n",
        "        \"auprc_median\": float(merged.auprc.median()),\n",
        "        \"pointing_hit\": float(merged.pointing_hit.mean()),\n",
        "        \"auprc_pred_positive\": float(pos.auprc.mean()) if len(pos) else None,\n",
        "        \"n_pred_positive\": int(len(pos)),\n",
        "        \"mean_pred_prob\": float(merged.pred_prob.mean()),\n",
        "    }\n",
        "    with open(os.path.join(seed_out, \"summary.json\"), \"w\") as f:\n",
        "        json.dump(s_sum, f, indent=4)\n",
        "\n",
        "    fig, ax = plt.subplots(1, 2, figsize=(9, 3.4))\n",
        "    ax[0].hist(merged.auprc, bins=30, color=\"steelblue\")\n",
        "    ax[0].axvline(merged.prevalence.mean(), color=\"r\", ls=\"--\",\n",
        "                  label=f\"random {merged.prevalence.mean():.3f}\")\n",
        "    ax[0].set_title(f\"seed {seed} ({CKPT_TAG}): per-image AUPRC\")\n",
        "    ax[0].set_xlabel(\"AUPRC\"); ax[0].legend(fontsize=8)\n",
        "    ax[1].hist(merged.pred_prob, bins=25, color=\"slategray\")\n",
        "    ax[1].axvline(0.5, color=\"r\", ls=\"--\")\n",
        "    ax[1].set_title(f\"seed {seed}: p(pneumonia)\"); ax[1].set_xlabel(\"prob\")\n",
        "    plt.tight_layout()\n",
        "    plt.savefig(os.path.join(seed_out, \"metrics.png\"), dpi=140, bbox_inches=\"tight\")\n",
        "    plt.close()\n",
        "\n",
        "    per_seed_rows.append(s_sum)\n",
        "    print(f\"  seed {seed:>5}: auprc {s_sum['auprc_mean']:.4f}  \"\n",
        "          f\"pointing {s_sum['pointing_hit']:.4f}\")\n",
        "\n",
        "psdf = pd.DataFrame(per_seed_rows)\n",
        "psdf.to_csv(os.path.join(AGG_DIR, \"per_seed_summary.csv\"), index=False)\n",
        "\n",
        "\n",
        "# aggregates\n",
        "per_seed = psdf.set_index(\"seed\").auprc_mean\n",
        "spread = float(per_seed.std(ddof=1))          # SD of per-seed means\n",
        "\n",
        "rng = np.random.default_rng(BOOT_SEED)\n",
        "boot = np.array([pd.Series(rng.choice(per_seed.values, len(per_seed), replace=True))\n",
        "                 .std(ddof=1) for _ in range(N_BOOT)])\n",
        "lo, hi = np.percentile(boot, [2.5, 97.5])\n",
        "\n",
        "per_img = sdf.groupby(\"patientId\").auprc.agg([\"mean\", \"std\"])\n",
        "q1, med, q3 = per_img[\"std\"].quantile([0.25, 0.50, 0.75])\n",
        "\n",
        "yy, xx = np.mgrid[0:SCORE_SIZE, 0:SCORE_SIZE]\n",
        "c = SCORE_SIZE / 2\n",
        "centre_map = np.exp(-((xx - c) ** 2 + (yy - c) ** 2) / (2 * (SCORE_SIZE / 5) ** 2))\n",
        "centre_flat = centre_map.astype(np.float32).reshape(-1)\n",
        "centre_scores = [auprc(gt.reshape(-1), centre_flat) for gt in masks.values()]\n",
        "\n",
        "print(f\"[{CKPT_TAG}] PRIMARY -- per-image AUPRC (threshold-free)\")\n",
        "print(psdf[[\"seed\", \"auprc_mean\", \"pointing_hit\", \"auprc_pred_positive\"]]\n",
        "      .round(4).to_string(index=False))\n",
        "print(f\"\\n  mean across seeds        : {per_seed.mean():.4f}\")\n",
        "print(f\"  SPREAD (SD of per-seed)  : {spread:.4f}  95% CI [{lo:.4f}, {hi:.4f}]\")\n",
        "print(f\"  per-seed range           : {per_seed.min():.4f} - {per_seed.max():.4f}\")\n",
        "print(f\"\\n  random-ranker baseline   : {sdf.prevalence.mean():.4f} \"\n",
        "      f\"(= mean positive-pixel rate)\")\n",
        "print(f\"  center-Gaussian baseline: {np.mean(centre_scores):.4f}\")\n",
        "print(f\"\\n  per-image SD across seeds: median {med:.4f}  IQR [{q1:.4f}, {q3:.4f}]\")\n",
        "print(f\"  pointing hit rate        : {psdf.pointing_hit.mean():.4f} \"\n",
        "      f\"+/- {psdf.pointing_hit.std():.4f}\")\n",
        "\n",
        "pairs = list(itertools.combinations(SEEDS, 2))\n",
        "agr_rows = []\n",
        "px_per_cell = SCORE_SIZE / CAM_NATIVE\n",
        "\n",
        "for pid in masks:\n",
        "    cams = {s: load_raw(s, pid) for s in SEEDS}\n",
        "    cams = {s: c for s, c in cams.items() if c is not None}\n",
        "    if len(cams) < 2:\n",
        "        continue\n",
        "    for a, b in pairs:\n",
        "        if a not in cams or b not in cams:\n",
        "            continue\n",
        "        rho, _ = spearmanr(cams[a].ravel(), cams[b].ravel())\n",
        "        ya, xa = np.unravel_index(np.argmax(cams[a]), cams[a].shape)\n",
        "        yb, xb = np.unravel_index(np.argmax(cams[b]), cams[b].shape)\n",
        "        agr_rows.append({\"patientId\": pid, \"seed_a\": a, \"seed_b\": b,\n",
        "                         \"spearman\": float(rho),\n",
        "                         \"peak_px\": float(np.hypot(ya - yb, xa - xb) * px_per_cell)})\n",
        "\n",
        "adf = pd.DataFrame(agr_rows)\n",
        "adf.to_csv(os.path.join(AGG_DIR, \"cam_agreement.csv\"), index=False)\n",
        "\n",
        "wide = preds.pivot_table(index=\"patientId\", columns=\"seed\", values=\"pred_label\")\n",
        "unanimous = float((wide.nunique(axis=1) == 1).mean())\n",
        "\n",
        "print(f\"[{CKPT_TAG}] inter-seed agreement ({len(pairs)} pairs, at 7x7 native)\")\n",
        "print(f\"  spearman  {adf.spearman.mean():.4f} +/- {adf.spearman.std():.4f}\")\n",
        "print(f\"  peak_px   {adf.peak_px.mean():.1f} +/- {adf.peak_px.std():.1f} \"\n",
        "      f\"(in 1024-px units)\")\n",
        "print(f\"  seeds unanimous on the label (thr 0.5): {unanimous:.1%}\")\n",
        "print(f\"  mean prob SD across seeds: \"\n",
        "      f\"{preds.groupby('patientId').pred_prob.std().mean():.4f}\")\n",
        "\n",
        "\n",
        "#save\n",
        "summary = {\n",
        "    \"checkpoint\": CKPT_TAG, \"score_size\": SCORE_SIZE,\n",
        "    \"n_seeds\": len(SEEDS), \"n_images\": len(masks),\n",
        "    \"n_all_zero_maps\": len(zero_maps),\n",
        "    \"auprc\": {\"mean_across_seeds\": float(per_seed.mean()),\n",
        "              \"spread_sd_of_per_seed_mean\": spread,\n",
        "              \"bootstrap_ci_95\": [float(lo), float(hi)],\n",
        "              \"per_seed_min\": float(per_seed.min()),\n",
        "              \"per_seed_max\": float(per_seed.max())},\n",
        "    \"per_image_sd\": {\"median\": float(med), \"iqr\": [float(q1), float(q3)]},\n",
        "    \"baseline_random\": float(sdf.prevalence.mean()),\n",
        "    \"baseline_centre_gaussian\": float(np.mean(centre_scores)),\n",
        "    \"pointing_hit\": {\"mean\": float(psdf.pointing_hit.mean()),\n",
        "                     \"std\": float(psdf.pointing_hit.std())},\n",
        "    \"agreement\": {\"spearman\": {\"mean\": float(adf.spearman.mean()),\n",
        "                               \"std\": float(adf.spearman.std())},\n",
        "                  \"peak_px\": {\"mean\": float(adf.peak_px.mean()),\n",
        "                              \"std\": float(adf.peak_px.std())}},\n",
        "    \"label_unanimity\": unanimous,\n",
        "}\n",
        "with open(os.path.join(AGG_DIR, \"summary.json\"), \"w\") as f:\n",
        "    json.dump(summary, f, indent=4)\n",
        "\n",
        "fig, ax = plt.subplots(1, 3, figsize=(16, 4.2))\n",
        "\n",
        "ax[0].bar(range(len(psdf)), psdf.auprc_mean, color=\"steelblue\")\n",
        "ax[0].axhline(sdf.prevalence.mean(), color=\"r\", ls=\"--\", label=\"random baseline\")\n",
        "ax[0].axhline(np.mean(centre_scores), color=\"orange\", ls=\"--\", label=\"centre baseline\")\n",
        "ax[0].set_xticks(range(len(psdf)))\n",
        "ax[0].set_xticklabels(psdf.seed, rotation=90, fontsize=7)\n",
        "ax[0].set_ylabel(\"mean AUPRC\"); ax[0].set_title(f\"per-seed AUPRC ({CKPT_TAG})\")\n",
        "ax[0].legend(fontsize=8)\n",
        "\n",
        "ax[1].hist(per_img[\"std\"], bins=40, color=\"seagreen\")\n",
        "ax[1].axvline(med, color=\"r\", ls=\"--\", label=f\"median {med:.3f}\")\n",
        "ax[1].set_xlabel(\"per-image SD across seeds\")\n",
        "ax[1].set_title(\"per-image variance\"); ax[1].legend(fontsize=8)\n",
        "\n",
        "ax[2].bar(range(len(psdf)), psdf.pointing_hit, color=\"indianred\")\n",
        "ax[2].set_xticks(range(len(psdf)))\n",
        "ax[2].set_xticklabels(psdf.seed, rotation=90, fontsize=7)\n",
        "ax[2].set_ylabel(\"hit rate\"); ax[2].set_title(f\"pointing game ({CKPT_TAG})\")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.savefig(os.path.join(AGG_DIR, \"metrics.png\"), dpi=150, bbox_inches=\"tight\")\n",
        "plt.show()\n",
        "\n",
        "print(f\"\\nper-seed  -> {OUT_DIR}/seed_*/\")\n",
        "print(f\"aggregate -> {AGG_DIR}\")"
      ]
    },
