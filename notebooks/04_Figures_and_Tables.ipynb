      "source": [
        "from sklearn.metrics import (precision_score, recall_score, fbeta_score,\n",
        "                             f1_score, accuracy_score)\n",
        "\n",
        "CKPT_TAG      = \"epoch25\"\n",
        "THRESHOLD_DIR = os.path.join(XRV_SAVE_DIR, \"threshold_sweep_25_withGBP\")\n",
        "os.makedirs(THRESHOLD_DIR, exist_ok=True)\n",
        "\n",
        "THRESHOLDS = np.round(np.arange(0.20, 0.81, 0.05), 2)\n",
        "\n",
        "# Sensitivity analysis, not threshold tuning. Picking the threshold that\n",
        "# maximises a test metric and reporting it would be selecting on the test set.\n",
        "rows = []\n",
        "for s in HPARAMS2[\"seeds\"]:\n",
        "    rn = f\"{HPARAMS2['run_name']}_seed{s}\"\n",
        "    f = os.path.join(XRV_SAVE_DIR, f\"{rn}_{CKPT_TAG}_test_probs.npz\")\n",
        "    if not os.path.exists(f):\n",
        "        continue\n",
        "    d = np.load(f)\n",
        "    yt, yp = d[\"y_true\"], d[\"y_prob\"]\n",
        "    for thr in THRESHOLDS:\n",
        "        pred = (yp >= thr).astype(int)\n",
        "        rows.append({\n",
        "            \"checkpoint\": CKPT_TAG, \"seed\": s, \"thr\": float(thr),\n",
        "            \"accuracy\":  accuracy_score(yt, pred),\n",
        "            \"precision\": precision_score(yt, pred, zero_division=0),\n",
        "            \"recall\":    recall_score(yt, pred, zero_division=0),\n",
        "            \"f1\":        f1_score(yt, pred, zero_division=0),\n",
        "            \"f2\":        fbeta_score(yt, pred, beta=2, zero_division=0),\n",
        "        })\n",
        "\n",
        "if not rows:\n",
        "    print(f\"No *_{CKPT_TAG}_test_probs.npz files found\")\n",
        "else:\n",
        "    tdf = pd.DataFrame(rows)\n",
        "    tdf.to_csv(os.path.join(THRESHOLD_DIR, \"per_seed.csv\"), index=False)\n",
        "\n",
        "    agg = (tdf.groupby(\"thr\")[[\"accuracy\", \"precision\", \"recall\", \"f1\", \"f2\"]]\n",
        "           .agg([\"mean\", \"std\"]).round(4))\n",
        "    print(f\"THRESHOLD SWEEP -- {CKPT_TAG}  ({tdf.seed.nunique()} seeds)\")\n",
        "    print(agg.to_string())\n",
        "    agg.to_csv(os.path.join(THRESHOLD_DIR, \"summary.csv\"))\n",
        "\n",
        "    peak = tdf.groupby(\"thr\").f2.mean().idxmax()\n",
        "    print(f\"\\n  highest mean F2 at thr {peak:.2f} \"\n",
        "          f\"(sensitivity only -- not a tuned threshold)\")\n",
        "\n",
        "    g = tdf.groupby(\"thr\")[[\"accuracy\", \"precision\", \"recall\", \"f1\", \"f2\"]].mean()\n",
        "    fig, ax = plt.subplots(1, 2, figsize=(12, 4))\n",
        "    ax[0].plot(g.index, g.precision, color=\"indianred\", ls=\"--\", label=\"precision\")\n",
        "    ax[0].plot(g.index, g.recall, color=\"indianred\", label=\"recall\")\n",
        "    ax[0].plot(g.index, g.accuracy, color=\"grey\", ls=\"-.\", label=\"accuracy\")\n",
        "    ax[0].axvline(0.5, color=\"grey\", ls=\":\", lw=1)\n",
        "    ax[0].set_xlabel(\"threshold\"); ax[0].set_title(f\"precision / recall ({CKPT_TAG})\")\n",
        "    ax[0].legend(fontsize=8)\n",
        "    ax[1].plot(g.index, g.f2, color=\"indianred\", label=\"F2\")\n",
        "    ax[1].plot(g.index, g.f1, color=\"grey\", ls=\"--\", label=\"F1\")\n",
        "    ax[1].axvline(0.5, color=\"grey\", ls=\":\", lw=1)\n",
        "    ax[1].axvline(peak, color=\"indianred\", ls=\":\", lw=1)\n",
        "    ax[1].set_xlabel(\"threshold\"); ax[1].set_title(f\"F1 / F2 ({CKPT_TAG})\")\n",
        "    ax[1].legend(fontsize=8)\n",
        "    plt.tight_layout()\n",
        "    plt.savefig(os.path.join(THRESHOLD_DIR, \"sweep.png\"), dpi=150,\n",
        "                bbox_inches=\"tight\")\n",
        "    plt.show()\n",
        "\n",
        "    print(f\"\\nsaved to {THRESHOLD_DIR}\")"
      ]
