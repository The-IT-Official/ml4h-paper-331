        "import os\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import cv2\n",
        "import matplotlib.pyplot as plt\n",
        "from matplotlib.patches import Rectangle\n",
        "\n",
        "CAM_ROOT = os.path.join(XRV_SAVE_DIR, \"gradcam_npy_25_fixedrelu\")\n",
        "AGG      = os.path.join(XRV_SAVE_DIR, \"gradcam_metrics_25_withGBP\", \"_aggregate\")\n",
        "OUT      = os.path.join(XRV_SAVE_DIR, \"images_output\")\n",
        "os.makedirs(OUT, exist_ok=True)\n",
        "\n",
        "SEEDS_SHOW = HPARAMS2[\"seeds\"][:5]        # five columns; mean/SD use all 21\n",
        "SEEDS_ALL  = HPARAMS2[\"seeds\"]\n",
        "DISP       = 1024\n",
        "\n",
        "plt.rcParams.update({\"font.size\": 8, \"figure.dpi\": 150})\n",
        "\n",
        "labels_df = pd.read_csv(\"/content/rsna-pneumonia-dataset-npy/stage_2_train_labels.csv\")\n",
        "per_img   = pd.read_csv(os.path.join(AGG, \"per_image_variance.csv\"))\n",
        "scores    = pd.read_csv(os.path.join(AGG, \"per_image_per_seed_scores.csv\"))\n",
        "\n",
        "\n",
        "#helpers\n",
        "def load_map(seed, pid):\n",
        "    f = os.path.join(CAM_ROOT, f\"seed_{seed}\", f\"{pid}.npy\")\n",
        "    if not os.path.exists(f):\n",
        "        return None\n",
        "    cam = np.maximum(np.load(f).astype(np.float32), 0)\n",
        "    cam = cam / max(cam.max(), 1e-8)\n",
        "    return cv2.resize(cam, (DISP, DISP), interpolation=cv2.INTER_LINEAR)\n",
        "\n",
        "\n",
        "def boxes_for(pid):\n",
        "    r = labels_df[(labels_df.patientId == pid) & (labels_df.Target == 1)]\n",
        "    r = r.dropna(subset=[\"x\", \"y\", \"width\", \"height\"])\n",
        "    return [(b.x, b.y, b.width, b.height) for _, b in r.iterrows()]\n",
        "\n",
        "\n",
        "def display_image(pid):\n",
        "    img = np.load(npy_map[pid]).astype(np.float32)\n",
        "    if img.ndim == 3:\n",
        "        img = img[..., 0]\n",
        "    img = (img - img.min()) / (img.max() - img.min() + 1e-8)\n",
        "    return cv2.resize(img, (DISP, DISP), interpolation=cv2.INTER_LINEAR)\n",
        "\n",
        "\n",
        "def frame(a, base, overlay=None, boxes=(), cmap=\"jet\", vmax=1.0, title=None):\n",
        "    a.imshow(base, cmap=\"gray\", vmin=0, vmax=1)\n",
        "    if overlay is not None:\n",
        "        a.imshow(overlay, cmap=cmap, alpha=0.45, vmin=0, vmax=vmax)\n",
        "    for (x, y, w, h) in boxes:\n",
        "        a.add_patch(Rectangle((x, y), w, h, fill=False,\n",
        "                              edgecolor=\"white\", lw=1.4))\n",
        "    if title:\n",
        "        a.set_title(title, fontsize=8)\n",
        "    a.set_xticks([]); a.set_yticks([])\n",
        "\n",
        "\n",
        "# one figure, one pid\n",
        "cand = per_img[per_img.patientId.isin(set(labels_df.patientId))].copy()\n",
        "MEDIAN_SD = float(cand[\"std\"].median())\n",
        "\n",
        "\n",
        "def make_figure(pid, fname, descriptor, label):\n",
        "    sd = float(cand.loc[cand.patientId == pid, \"std\"].iloc[0])\n",
        "    per_seed = (scores[scores.patientId == pid]\n",
        "                .set_index(\"seed\").auprc.reindex(SEEDS_ALL))\n",
        "\n",
        "    cams = {s: load_map(s, pid) for s in SEEDS_ALL}\n",
        "    cams = {s: c for s, c in cams.items() if c is not None}\n",
        "    if not cams:\n",
        "        print(f\"[{fname}] no maps found for {pid}, skipping\")\n",
        "        return\n",
        "    stack = np.stack(list(cams.values()))\n",
        "    mean_cam, std_map = stack.mean(0), stack.std(0)\n",
        "\n",
        "    disp, boxes = display_image(pid), boxes_for(pid)\n",
        "    shown = [s for s in SEEDS_SHOW if s in cams]\n",
        "\n",
        "    n_cols = 1 + len(shown) + 2\n",
        "    fig, ax = plt.subplots(1, n_cols, figsize=(1.65 * n_cols, 2.3))\n",
        "\n",
        "    frame(ax[0], disp, boxes=boxes, title=\"radiograph\")\n",
        "\n",
        "    for i, s in enumerate(shown, start=1):\n",
        "        frame(ax[i], disp, cams[s], boxes, title=f\"seed {s}\")\n",
        "        ax[i].set_xlabel(f\"AUPRC {per_seed[s]:.3f}\", fontsize=7)\n",
        "\n",
        "    cm = len(shown) + 1\n",
        "    frame(ax[cm], disp, mean_cam, boxes, title=f\"mean ({len(cams)} seeds)\")\n",
        "\n",
        "    k = cm + 1\n",
        "    ax[k].imshow(std_map, cmap=\"magma\", vmin=0, vmax=float(std_map.max()))\n",
        "    for (x, y, w, h) in boxes:\n",
        "        ax[k].add_patch(Rectangle((x, y), w, h, fill=False,\n",
        "                                  edgecolor=\"white\", lw=1.4))\n",
        "    ax[k].set_title(\"SD across seeds\", fontsize=8)\n",
        "    ax[k].set_xticks([]); ax[k].set_yticks([])\n",
        "\n",
        "    fig.suptitle(f\"{descriptor}: {label}, per-seed AUPRC SD {sd:.3f} \"\n",
        "                 f\"(median across 601 images {MEDIAN_SD:.3f})\",\n",
        "                 fontsize=8, y=1.02)\n",
        "\n",
        "    plt.tight_layout()\n",
        "    for ext in (\"pdf\", \"png\"):\n",
        "        plt.savefig(os.path.join(OUT, f\"{fname}.{ext}\"), bbox_inches=\"tight\")\n",
        "    plt.show()\n",
        "\n",
        "    cap = (\n",
        "        f\"Grad-CAM maps for patient {pid}, {descriptor.lower()} among the 601 \"\n",
        "        f\"box-bearing test images by per-seed AUPRC standard deviation \"\n",
        "        f\"({sd:.3f}; median across images {MEDIAN_SD:.3f}). Five of the 21 seeds \"\n",
        "        f\"are shown with their per-image AUPRC; the mean and standard deviation \"\n",
        "        f\"panels use all {len(cams)} seeds. Per-seed AUPRC for this image ranges \"\n",
        "        f\"{per_seed.min():.3f} to {per_seed.max():.3f}. Ground-truth boxes in \"\n",
        "        f\"white.\"\n",
        "    )\n",
        "    with open(os.path.join(OUT, f\"{fname}_caption.txt\"), \"w\") as f:\n",
        "        f.write(cap)\n",
        "\n",
        "    print(f\"[{fname}] {pid}  SD {sd:.4f}  \"\n",
        "          f\"AUPRC {per_seed.min():.3f}-{per_seed.max():.3f}\")\n",
        "    print(f\"  saved -> {OUT}/{fname}.pdf\")\n",
        "    print(f\"  {cap}\\n\")\n",
        "\n",
        "\n",
        "#run\n",
        "pid_worst  = cand.loc[cand[\"std\"].idxmax(), \"patientId\"]\n",
        "pid_median = cand.loc[(cand[\"std\"] - MEDIAN_SD).abs().idxmin(), \"patientId\"]\n",
        "\n",
        "print(f\"median per-image SD across 601 images: {MEDIAN_SD:.4f}\\n\")\n",
        "\n",
        "make_figure(pid_worst,  \"worst_sd\",  \"Most variable image\", \"Patient A\")\n",
        "make_figure(pid_median, \"median_sd\", \"Median-variability image\", \"Patient B\")"
      ]
    },
