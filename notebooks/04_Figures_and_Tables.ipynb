        "ax[0].set_xlabel(\"number of training runs ($k$)\")\n",
        "ax[0].set_ylabel(\"estimated seed SD\")\n",
        "ax[0].set_xticks(list(K_RANGE)[::2])\n",
        "ax[0].legend(fontsize=7, frameon=False, ncol=3,\n",
        "             loc=\"upper center\", bbox_to_anchor=(0.5, -0.22))\n",
        "\n",
        "ax[1].plot(cur.k, cur.within_tol, color=BLUE, lw=1.6, marker=\"o\", ms=3)\n",
        "ax[1].axvline(10, color=GRAY, ls=\"--\", lw=1.2, label=\"recommended minimum (10)\")\n",
        "ax[1].set_xlabel(\"number of training runs ($k$)\")\n",
        "ax[1].set_ylabel(f\"P(estimate within +/-{TOL:.0%})\")\n",
        "ax[1].set_ylim(0, 1.02)\n",
        "ax[1].set_xticks(list(K_RANGE)[::2])\n",
        "ax[1].legend(fontsize=7, frameon=False, ncol=1,\n",
        "             loc=\"upper center\", bbox_to_anchor=(0.5, -0.22))\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.savefig(os.path.join(OUT, \"F7_seeds.pdf\"), bbox_inches=\"tight\")\n",
