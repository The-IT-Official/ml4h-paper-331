        "class RSNADatasetXRV(Dataset):\n",
        "\n",
        "    def __init__(self, dataframe, npy_map, transform=None):\n",
        "        self.df = dataframe\n",
        "        self.npy_map = npy_map\n",
        "        self.transform = transform\n",
        "\n",
        "    def __len__(self):\n",
        "        return len(self.df)\n",
        "\n",
        "    def __getitem__(self, idx):\n",
        "        row = self.df.iloc[idx]\n",
        "        patient_id = row[\"patientId\"]\n",
        "\n",
        "        if patient_id not in self.npy_map:\n",
        "            raise KeyError(f\"Missing NPY for {patient_id}\")\n",
        "\n",
        "        img = np.load(self.npy_map[patient_id]).astype(np.float32)\n",
        "        img = (img - img.min()) / (img.max() - img.min() + 1e-8)   # -> [0, 1]\n",
        "        img = (img * 255.0).clip(0, 255).astype(np.uint8)          # -> uint8 [0, 255], required by CLAHE\n",
        "\n",
        "        if self.transform:\n",
        "            img = self.transform(image=img)[\"image\"]               # still uint8 HxW here\n",
        "\n",
        "        img = img.astype(np.float32)\n",
        "        img = xrv.datasets.normalize(img, 255)                      # -> XRV's expected range\n",
        "        img = torch.from_numpy(img).unsqueeze(0).float()            # -> [1, H, W]\n",
        "\n",
        "        label = torch.tensor(int(row[\"Target\"]), dtype=torch.long)\n",
        "        bbox = torch.tensor(\n",
        "            [row[\"x\"], row[\"y\"], row[\"width\"], row[\"height\"]],\n",
        "            dtype=torch.float32,\n",
        "        )\n",
        "\n",
        "        return {\n",
        "            \"image\": img,\n",
        "            \"label\": label,\n",
        "            \"bbox\": bbox,\n",
        "            \"patient_id\": patient_id,\n",
        "        }"
      ]
    },
