      "source": [
        "#B1-A (T2)\n",
        "import os, json\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "from scipy import stats\n",
        "\n",
        "AGG_7  = os.path.join(XRV_SAVE_DIR, \"gradcam_metrics_25_withGBP\", \"_aggregate\")\n",
        "DIR_14 = os.path.join(XRV_SAVE_DIR, \"gradcam_metrics_25_denseblock3\")\n",
        "OUT    = os.path.join(XRV_SAVE_DIR, \"paper_outputs\")\n",
        "os.makedirs(OUT, exist_ok=True)\n",
        "\n",
        "SD_THRESH = 0.02\n",
        "\n",
        "for p in (AGG_7, DIR_14):\n",
        "    if not os.path.isdir(p):\n",
        "        raise SystemExit(f\"not found: {p}\")\n",
        "\n",
        "\n",
        "def load_7x7(d):\n",
        "    sj = json.load(open(os.path.join(d, \"summary.json\")))\n",
        "    ps = pd.read_csv(os.path.join(d, \"per_seed_summary.csv\")).sort_values(\"seed\")\n",
        "    pv = pd.read_csv(os.path.join(d, \"per_image_variance.csv\"))\n",
        "    pa = sj[\"primary_auprc\"]\n",
        "    return {\"per_seed\": ps.set_index(\"seed\").auprc_mean,\n",
        "            \"pointing\": ps.set_index(\"seed\").pointing_hit,\n",
        "            \"mean\": float(pa[\"mean_across_seeds\"]),\n",
        "            \"sd\":   float(pa[\"spread_sd_of_per_seed_mean\"]),\n",
        "            \"ci\":   [float(x) for x in pa[\"bootstrap_ci_95\"]],\n",
        "            \"floor\": float(sj[\"baseline_random\"]),\n",
        "            \"frac\":  float((pv[\"std\"] > SD_THRESH).mean()),\n",
        "            \"sd_median\": float(pv[\"std\"].median()),\n",
        "            \"n_img\": int(sj[\"n_images\"]), \"n_seeds\": int(sj[\"n_seeds\"])}\n",
        "\n",
        "\n",
        "def load_14x14(d):\n",
        "    aj = json.load(open(os.path.join(d, \"aggregate.json\")))\n",
        "    ps = pd.read_csv(os.path.join(d, \"per_seed.csv\")).sort_values(\"seed\")\n",
        "    return {\"per_seed\": ps.set_index(\"seed\").auprc_mean,\n",
        "            \"pointing\": ps.set_index(\"seed\").pointing_hit,\n",
        "            \"mean\": float(aj[\"mean_across_seeds\"]),\n",
        "            \"sd\":   float(aj[\"spread_sd\"]),\n",
        "            \"ci\":   [float(x) for x in aj[\"spread_ci95\"]],\n",
        "            \"floor\": None,                      # not stored; taken from the 7x7 arm\n",
        "            \"frac\":  float(aj[f\"frac_images_sd_gt_{SD_THRESH}\"]),\n",
        "            \"sd_median\": float(aj[\"per_image_sd_median\"]),\n",
        "            \"n_img\": int(aj[\"n_images\"]), \"n_seeds\": int(aj[\"n_seeds\"]),\n",
        "            \"layer\": aj.get(\"layer\"), \"raw_shape\": aj.get(\"raw_map_shape\"),\n",
        "            \"stored_rho\": float(aj[\"vs_paper_7x7_per_seed\"][\"rank_spearman\"]),\n",
        "            \"stored_improved\": int(aj[\"vs_paper_7x7_per_seed\"][\"seeds_improved\"])}\n",
        "\n",
        "\n",
        "a7  = load_7x7(AGG_7)\n",
        "a14 = load_14x14(DIR_14)\n",
        "\n",
        "assert set(a7[\"per_seed\"].index) == set(a14[\"per_seed\"].index), \"seed sets differ\"\n",
        "assert a7[\"n_img\"] == a14[\"n_img\"], f\"image counts differ: {a7['n_img']} vs {a14['n_img']}\"\n",
        "\n",
        "# the chance floor is a property of the box masks, identical for both arms\n",
        "FLOOR = a7[\"floor\"]\n",
        "\n",
        "h7  = a7[\"sd\"]  / (a7[\"mean\"]  - FLOOR)\n",
        "h14 = a14[\"sd\"] / (a14[\"mean\"] - FLOOR)\n",
        "rho, rho_p = stats.spearmanr(a7[\"per_seed\"].values, a14[\"per_seed\"].values)\n",
        "n_lower = int((a14[\"per_seed\"] < a7[\"per_seed\"]).sum())\n",
        "\n",
        "t2 = pd.DataFrame([\n",
        "    {\"Metric\": \"Mean AUPRC\",\n",
        "     \"7x7 (final features)\": f\"{a7['mean']:.3f}\",\n",
        "     \"14x14 (dense block 3)\": f\"{a14['mean']:.3f}\"},\n",
        "    {\"Metric\": \"Seed SD (95% CI)\",\n",
        "     \"7x7 (final features)\": f\"{a7['sd']:.4f} ({a7['ci'][0]:.4f}, {a7['ci'][1]:.4f})\",\n",
        "     \"14x14 (dense block 3)\": f\"{a14['sd']:.4f} ({a14['ci'][0]:.4f}, {a14['ci'][1]:.4f})\"},\n",
        "    {\"Metric\": f\"SD / headroom above chance ({FLOOR:.3f})\",\n",
        "     \"7x7 (final features)\": f\"{h7:.2f}\",\n",
        "     \"14x14 (dense block 3)\": f\"{h14:.2f}\"},\n",
        "    {\"Metric\": f\"Images with seed SD > {SD_THRESH}\",\n",
        "     \"7x7 (final features)\": f\"{a7['frac']:.0%}\",\n",
        "     \"14x14 (dense block 3)\": f\"{a14['frac']:.0%}\"},\n",
        "    {\"Metric\": \"Pointing-game range across seeds\",\n",
        "     \"7x7 (final features)\": f\"{a7['pointing'].min():.2f}-{a7['pointing'].max():.2f}\",\n",
        "     \"14x14 (dense block 3)\": f\"{a14['pointing'].min():.2f}-{a14['pointing'].max():.2f}\"},\n",
        "])\n",
        "\n",
        "print(f\"({a7['n_seeds']} seeds, {a7['n_img']} images)\")\n",
        "print(f\"    14x14 arm: layer {a14['layer']}, raw map {a14['raw_shape']}\")\n",
        "print(t2.to_string(index=False))\n",
        "print(f\"\\n  per-seed Spearman between layers : rho = {rho:.2f} (p = {rho_p:.4f})\")\n",
        "print(f\"  14x14 lower than 7x7 on          : {n_lower}/{a7['n_seeds']} seeds\")\n",
        "print(f\"  per-image SD median              : {a7['sd_median']:.4f} (7x7)  \"\n",
        "      f\"{a14['sd_median']:.4f} (14x14)\")\n",
        "\n",
        "t2.to_csv(os.path.join(OUT, \"T2_resolution.csv\"), index=False)\n",
        "\n",
        "latex = r\"\"\"\\begin{table}[htbp]\n",
        "\\centering\n",
        "\\small\n",
        "\\setlength{\\tabcolsep}{4pt}\n",
        "\\caption{Grad-CAM at the final feature block ($7\\times7$) and at dense\n",
        "block~3 ($14\\times14$), on the same 21 epoch-25 checkpoints and the same %d\n",
        "images under the identical scoring protocol. No models were retrained.}\n",
        "\\label{tab:resolution}\n",
        "\\begin{tabular}{@{}lcc@{}}\n",
        "\\toprule\n",
        " & \\textbf{$7\\times7$} & \\textbf{$14\\times14$} \\\\\n",
        " & \\textbf{final features} & \\textbf{dense block 3} \\\\\n",
        "\\midrule\n",
        "Mean AUPRC                   & %.3f & %.3f \\\\\n",
        "Seed SD                      & %.4f & %.4f \\\\\n",
        "\\quad 95\\%% bootstrap CI      & [%.4f, %.4f] & [%.4f, %.4f] \\\\\n",
        "SD / headroom above chance   & %.2f & %.2f \\\\\n",
        "Images with seed SD $>$ %.2f  & %.0f\\%% & %.0f\\%% \\\\\n",
        "Pointing-game range          & %.2f--%.2f & %.2f--%.2f \\\\\n",
        "\\bottomrule\n",
        "\\end{tabular}\n",
        "\\end{table}\n",
        "\"\"\" % (a7[\"n_img\"], a7[\"mean\"], a14[\"mean\"], a7[\"sd\"], a14[\"sd\"],\n",
        "       a7[\"ci\"][0], a7[\"ci\"][1], a14[\"ci\"][0], a14[\"ci\"][1], h7, h14,\n",
        "       SD_THRESH, 100 * a7[\"frac\"], 100 * a14[\"frac\"],\n",
        "       a7[\"pointing\"].min(), a7[\"pointing\"].max(),\n",
        "       a14[\"pointing\"].min(), a14[\"pointing\"].max())\n",
        "open(os.path.join(OUT, \"T2_resolution.tex\"), \"w\").write(latex)\n",
        "\n",
        "with open(os.path.join(OUT, \"B1_stats.json\"), \"w\") as f:\n",
        "    json.dump({\"n_seeds\": a7[\"n_seeds\"], \"n_images\": a7[\"n_img\"],\n",
        "               \"chance_floor\": FLOOR,\n",
        "               \"grid_7x7\":  {\"mean\": a7[\"mean\"], \"sd\": a7[\"sd\"], \"ci95\": a7[\"ci\"],\n",
        "                             \"sd_over_headroom\": h7,\n",
        "                             \"frac_img_sd_above_0.02\": a7[\"frac\"],\n",
        "                             \"per_image_sd_median\": a7[\"sd_median\"],\n",
        "                             \"pointing_range\": [float(a7[\"pointing\"].min()),\n",
        "                                                float(a7[\"pointing\"].max())]},\n",
        "               \"grid_14x14\": {\"mean\": a14[\"mean\"], \"sd\": a14[\"sd\"], \"ci95\": a14[\"ci\"],\n",
        "                              \"sd_over_headroom\": h14,\n",
        "                              \"frac_img_sd_above_0.02\": a14[\"frac\"],\n",
        "                              \"per_image_sd_median\": a14[\"sd_median\"],\n",
        "                              \"pointing_range\": [float(a14[\"pointing\"].min()),\n",
        "                                                 float(a14[\"pointing\"].max())],\n",
        "                              \"layer\": a14[\"layer\"], \"raw_map_shape\": a14[\"raw_shape\"]},\n",
        "               \"spearman_between_layers\": float(rho), \"spearman_p\": float(rho_p),\n",
        "               \"n_seeds_14_lower\": n_lower}, f, indent=4)\n",
        "\n",
        "print(f\"\\nsaved -> {OUT}/T2_resolution.csv, T2_resolution.tex, B1_stats.json\")\n",
        "\n",
        "for nm, got in [(\"mean AUPRC 14x14\", a14[\"mean\"]),\n",
        "                (\"seed SD 14x14\", a14[\"sd\"]),\n",
        "                (\"CI lo 14x14\", a14[\"ci\"][0]),\n",
        "                (\"CI hi 14x14\", a14[\"ci\"][1]),\n",
        "                (\"seed SD 7x7\", a7[\"sd\"]),\n",
        "                (\"SD/headroom 14x14\", h14),\n",
        "                (\"SD/headroom 7x7\", h7),\n",
        "                (\"frac >0.02 at 14x14\", a14[\"frac\"]),\n",
        "                (\"Spearman\", rho)]:\n",
        "    print(f\"  {nm:<22s} {got:.4f}\")"
      ],
      "id": "T99hcAuN2Mjb"
    },
