      "outputs": [],
      "source": [
        "import os, json\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import cv2\n",
        "import matplotlib.pyplot as plt\n",
        "from scipy import stats\n",
        "from sklearn.metrics import average_precision_score\n",
        "\n",
        "AGG      = os.path.join(XRV_SAVE_DIR, \"gradcam_metrics_25_withGBP\", \"_aggregate\")\n",
        "OUT      = os.path.join(XRV_SAVE_DIR, \"paper_outputs\")\n",
        "os.makedirs(OUT, exist_ok=True)\n",
        "\n",
        "SCORE_SIZE = 1024\n",
        "N_BOOT     = 1000\n",
        "rng = np.random.default_rng(42)\n",
        "\n",
        "plt.rcParams.update({\"font.size\": 9, \"axes.spines.top\": False,\n",
        "                     \"axes.spines.right\": False, \"figure.dpi\": 150})\n",
        "\n",
        "scores  = pd.read_csv(os.path.join(AGG, \"per_image_per_seed_scores.csv\"))\n",
        "per_seed = pd.read_csv(os.path.join(AGG, \"per_seed_summary.csv\"))\n",
        "per_img  = pd.read_csv(os.path.join(AGG, \"per_image_variance.csv\"))\n",
        "equiv    = pd.read_csv(os.path.join(AGG, \"model_equivalence.csv\"))\n",
        "summ     = json.load(open(os.path.join(AGG, \"summary.json\")))\n",
        "\n",
        "labels_df = pd.read_csv(\"/content/rsna-pneumonia-dataset-npy/stage_2_train_labels.csv\")\n",
        "\n",
        "SPREAD   = summ[\"primary_auprc\"][\"spread_sd_of_per_seed_mean\"]\n",
        "CI       = summ[\"primary_auprc\"][\"bootstrap_ci_95\"]\n",
        "GAPS     = summ[\"arun_gaps\"]\n",
        "RANDOM_B = summ[\"baseline_random\"]\n",
        "CENTRE_B = summ[\"baseline_centre_gaussian\"]\n",
        "\n",
        "R = {}   # everything reportable ends up here\n",
        "\n",
        "wide = scores.pivot(index=\"patientId\", columns=\"seed\", values=\"auprc\").dropna()\n",
        "obs = wide.mean(axis=0).std(ddof=1)\n",
        "\n",
        "null = np.empty(N_BOOT)\n",
        "vals = wide.to_numpy()\n",
        "for b in range(N_BOOT):\n",
        "    permuted = np.apply_along_axis(rng.permutation, 1, vals)   # shuffle within image\n",
        "    null[b] = permuted.mean(axis=0).std(ddof=1)\n",
        "p_perm = (np.sum(null >= obs) + 1) / (N_BOOT + 1)\n",
        "\n",
        "f_stat, p_anova = stats.f_oneway(*[wide[c].values for c in wide.columns])\n",
        "\n",
        "R[\"between_seed_variance\"] = {\n",
        "    \"observed_sd\": float(obs),\n",
        "    \"null_sd_mean\": float(null.mean()),\n",
        "    \"null_sd_95th\": float(np.percentile(null, 95)),\n",
        "    \"permutation_p\": float(p_perm),\n",
        "    \"anova_F\": float(f_stat), \"anova_p\": float(p_anova),\n",
        "    \"n_permutations\": N_BOOT,\n",
        "}\n",
        "print(\"=\" * 72)\n",
        "print(\"1. BETWEEN-SEED VARIANCE\")\n",
        "print(\"=\" * 72)\n",
        "print(f\"  observed SD of per-seed means : {obs:.4f}\")\n",
        "print(f\"  permutation null              : {null.mean():.4f} \"\n",
        "      f\"(95th pct {np.percentile(null,95):.4f})\")\n",
        "print(f\"  permutation p                 : {p_perm:.4f}\")\n",
        "print(f\"  one-way ANOVA                 : F={f_stat:.2f}, p={p_anova:.3e}\")\n",
        "\n",
        "\n",
        "def box_mask(pid):\n",
        "    r = labels_df[(labels_df.patientId == pid) & (labels_df.Target == 1)]\n",
        "    r = r.dropna(subset=[\"x\", \"y\", \"width\", \"height\"])\n",
        "    if r.empty:\n",
        "        return None\n",
        "    m = np.zeros((SCORE_SIZE, SCORE_SIZE), np.uint8)\n",
        "    for _, b in r.iterrows():\n",
        "        x0, y0 = int(b.x), int(b.y)\n",
        "        x1, y1 = int(b.x + b.width), int(b.y + b.height)\n",
        "        m[max(y0, 0):min(y1, SCORE_SIZE), max(x0, 0):min(x1, SCORE_SIZE)] = 1\n",
        "    return m if m.sum() else None\n",
        "\n",
        "\n",
        "yy, xx = np.mgrid[0:SCORE_SIZE, 0:SCORE_SIZE]\n",
        "c = SCORE_SIZE / 2\n",
        "centre_map = np.exp(-((xx - c) ** 2 + (yy - c) ** 2) /\n",
        "                    (2 * (SCORE_SIZE / 5) ** 2)).astype(np.float32).ravel()\n",
        "\n",
        "print(\"\\n  scoring the centre-Gaussian baseline per image...\")\n",
        "centre_by_pid = {}\n",
        "for i, pid in enumerate(wide.index, 1):\n",
        "    gt = box_mask(pid)\n",
        "    if gt is not None:\n",
        "        centre_by_pid[pid] = float(average_precision_score(gt.ravel(), centre_map))\n",
        "    if i % 200 == 0:\n",
        "        print(f\"    {i}/{len(wide)}\")\n",
        "\n",
        "cb = pd.Series(centre_by_pid)\n",
        "rows = []\n",
        "for seed in wide.columns:\n",
        "    d = wide[seed] - cb.reindex(wide.index)\n",
        "    w_stat, w_p = stats.wilcoxon(wide[seed], cb.reindex(wide.index))\n",
        "    rows.append({\"seed\": seed, \"auprc\": wide[seed].mean(),\n",
        "                 \"diff_vs_centre\": d.mean(), \"wilcoxon_p\": w_p,\n",
        "                 \"beats_centre\": bool(d.mean() > 0)})\n",
        "cmp_centre = pd.DataFrame(rows)\n",
        "cmp_centre.to_csv(os.path.join(OUT, \"vs_centre_baseline.csv\"), index=False)\n",
        "\n",
        "n_below = int((~cmp_centre.beats_centre).sum())\n",
        "n_sig_worse = int(((cmp_centre.diff_vs_centre < 0) & (cmp_centre.wilcoxon_p < .05)).sum())\n",
        "n_sig_better = int(((cmp_centre.diff_vs_centre > 0) & (cmp_centre.wilcoxon_p < .05)).sum())\n",
        "\n",
        "R[\"vs_centre_baseline\"] = {\n",
        "    \"baseline_auprc\": float(cb.mean()),\n",
        "    \"seeds_below\": n_below, \"seeds_significantly_worse\": n_sig_worse,\n",
        "    \"seeds_significantly_better\": n_sig_better,\n",
        "    \"mean_margin\": float(per_seed.auprc_mean.mean() - cb.mean()),\n",
        "    \"spread_over_margin\": float(SPREAD / (per_seed.auprc_mean.mean() - cb.mean())),\n",
        "}\n",
        "print(\"\\n\" + \"=\" * 72)\n",
        "print(\"2. VERSUS THE CENTRE-GAUSSIAN BASELINE\")\n",
        "print(\"=\" * 72)\n",
        "print(f\"  baseline mean AUPRC        : {cb.mean():.4f}\")\n",
        "print(f\"  seeds scoring below it     : {n_below}/21\")\n",
        "print(f\"  significantly worse (p<.05): {n_sig_worse}/21\")\n",
        "print(f\"  significantly better       : {n_sig_better}/21\")\n",
        "print(f\"  mean margin over baseline  : {R['vs_centre_baseline']['mean_margin']:+.4f}\")\n",
        "print(f\"  seed spread / margin       : {R['vs_centre_baseline']['spread_over_margin']:.1f}x\")\n",
        "\n",
        "\n",
        "# localization vs classification\n",
        "merged = per_seed.merge(equiv, on=\"seed\")\n",
        "R[\"loc_vs_class\"] = {}\n",
        "print(\"\\n\" + \"=\" * 72)\n",
        "print(\"3. LOCALIZATION vs CLASSIFICATION (per seed, n=21)\")\n",
        "print(\"=\" * 72)\n",
        "for col, lab in [(\"test_roc_auc\", \"ROC-AUC\"), (\"test_pr_auc\", \"PR-AUC\")]:\n",
        "    r_p, p_p = stats.pearsonr(merged.auprc_mean, merged[col])\n",
        "    r_s, p_s = stats.spearmanr(merged.auprc_mean, merged[col])\n",
        "    lo, hi = np.percentile([\n",
        "        stats.pearsonr(*merged.iloc[rng.choice(len(merged), len(merged), True)]\n",
        "                       [[\"auprc_mean\", col]].values.T)[0]\n",
        "        for _ in range(N_BOOT)], [2.5, 97.5])\n",
        "    R[\"loc_vs_class\"][lab] = {\"pearson_r\": float(r_p), \"pearson_p\": float(p_p),\n",
        "                              \"pearson_ci95\": [float(lo), float(hi)],\n",
        "                              \"spearman_rho\": float(r_s), \"spearman_p\": float(p_s)}\n",
