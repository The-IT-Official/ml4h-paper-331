        "\n",
        "# Get unique patient IDs in the test split\n",
        "test_patients = set(test_df[\"patientId\"])\n",
        "\n",
        "# Keep labels belonging to the test split\n",
        "test_labels = labels_df[labels_df[\"patientId\"].isin(test_patients)]\n",
        "\n",
        "# Count unique patients by Target\n",
        "patient_targets = test_labels.groupby(\"patientId\")[\"Target\"].max()\n",
        "\n",
        "positive = (patient_targets == 1).sum()\n",
        "negative = (patient_targets == 0).sum()\n",
        "\n",
        "print(\"Test patients:\", len(patient_targets))\n",
        "print(\"Positive patients:\", positive)\n",
        "print(\"Negative patients:\", negative)\n",
        "print(\"Positive percentage:\", positive / len(patient_targets) * 100)"
      ]
