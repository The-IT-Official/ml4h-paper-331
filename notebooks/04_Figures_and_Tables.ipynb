        "#B1-B (F6)\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "plt.rcParams.update({\"font.size\": 9, \"axes.spines.top\": False,\n",
        "                     \"axes.spines.right\": False, \"figure.dpi\": 150})\n",
        "\n",
        "C7, C14 = \"#082a54\", \"#e02b35\"\n",
        "CENTRE_B = json.load(open(os.path.join(AGG_7, \"summary.json\")))[\"baseline_centre_gaussian\"]\n",
        "\n",
        "order = a7[\"per_seed\"].sort_values().index\n",
        "v7, v14 = a7[\"per_seed\"].loc[order].values, a14[\"per_seed\"].loc[order].values\n",
        "x, w = np.arange(len(order)), 0.40\n",
        "\n",
        "fig, ax = plt.subplots(1, 2, figsize=(9.5, 3.2))\n",
        "\n",
        "ax[0].bar(x - w / 2, v7,  w, color=C7,  label=r\"$7\\times7$ (final features)\")\n",
