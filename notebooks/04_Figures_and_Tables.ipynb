        "import os, json\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "AGG_7 = os.path.join(XRV_SAVE_DIR, \"gradcam_metrics_25_withGBP\", \"_aggregate\")\n",
        "OUT   = os.path.join(XRV_SAVE_DIR, \"paper_outputs\")\n",
        "os.makedirs(OUT, exist_ok=True)\n",
        "\n",
        "N_DRAW  = 200000         # draws per k\n",
        "TOL     = 0.25           # \"within +/-25% of the full-sample value\"\n",
        "K_RANGE = range(2, 21)\n",
        "rng = np.random.default_rng(42)\n",
        "\n",
        "per_seed = (pd.read_csv(os.path.join(AGG_7, \"per_seed_summary.csv\"))\n",
        "            .sort_values(\"seed\").auprc_mean.values)\n",
        "N      = len(per_seed)\n",
        "SD_ALL = per_seed.std(ddof=1)\n",
        "\n",
        "rows = []\n",
        "for k in K_RANGE:\n",
        "    s = np.array([rng.choice(per_seed, k, replace=False).std(ddof=1)\n",
        "                  for _ in range(N_DRAW)])\n",
        "    lo, hi = np.percentile(s, [2.5, 97.5])\n",
        "    rows.append({\"k\": k, \"median\": np.median(s), \"lo95\": lo, \"hi95\": hi,\n",
        "                 \"within_tol\": float((np.abs(s - SD_ALL) / SD_ALL < TOL).mean()),\n",
        "                 \"understate_factor\": SD_ALL / lo})\n",
        "cur = pd.DataFrame(rows)\n",
        "\n",
        "print(f\"full-sample SD ({N} seeds) = {SD_ALL:.4f}   {N_DRAW:,} draws per k\\n\")\n",
        "print(cur.round(4).to_string(index=False))\n",
        "cur.to_csv(os.path.join(OUT, \"T3_seeds_needed.csv\"), index=False)\n",
        "\n",
        "for k in (5, 10):\n",
        "    r = cur[cur.k == k].iloc[0]\n",
        "    print(f\"\\n  k = {k:>2}: SD {r.lo95:.3f} to {r.hi95:.3f}, \"\n",
        "          f\"within {TOL:.0%} in {r.within_tol:.0%} of draws, \"\n",
        "          f\"understates by up to {r.understate_factor:.1f}x\")\n",
        "\n",
        "plt.rcParams.update({\"font.size\": 9, \"axes.spines.top\": False,\n",
        "                     \"axes.spines.right\": False, \"figure.dpi\": 150})\n",
        "BLUE, RED, GRAY = \"#082a54\", \"#e02b35\", \"#7f7f7f\"\n",
        "\n",
        "fig, ax = plt.subplots(1, 2, figsize=(9.5, 3.2))\n",
        "\n",
        "ax[0].fill_between(cur.k, cur.lo95, cur.hi95, color=BLUE, alpha=.2, lw=0,\n",
        "                   zorder=0,\n",
        "                   label=\"95% interval of the estimate\")\n",
        "ax[0].plot(cur.k, cur[\"median\"], color=BLUE, lw=1.6, zorder=3,\n",
        "           label=\"median estimate\")\n",
        "ax[0].axhline(SD_ALL, color=RED, ls=\"--\", lw=1.2, zorder=2,\n",
