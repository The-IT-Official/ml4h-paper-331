      "source": [
        "part 3: comparison (exploratory)\n",
        "\n",
        "Both arms scored the same 601 images with the same 21 seeds, so every\n",
        "comparison here is paired.  best checkpoint is selected on validation ROC-AUC and the winning epoch differs by seed, so its spread mixes seed variance with\n",
        "checkpoint-selection variance. The epoch-25 arm has only the former.\n",
        "\n",
        "paired AUPRC comparison"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "d933732a",
      "metadata": {
        "id": "d933732a"
      },
      "outputs": [],
      "source": [
        "import os, json\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "from scipy.stats import wilcoxon, spearmanr, levene\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "BEST_AGG = os.path.join(XRV_SAVE_DIR, \"gradcam_metrics_best_withGBP\", \"_aggregate\")\n",
        "E25_AGG  = os.path.join(XRV_SAVE_DIR, \"gradcam_metrics_25_withGBP\", \"_aggregate\") # Corrected directory name\n",
        "OUT_DIR  = os.path.join(XRV_SAVE_DIR, \"checkpoint_comparison_withGBP\")\n",
        "os.makedirs(OUT_DIR, exist_ok=True)\n",
        "\n",
        "N_BOOT = 1000\n",
        "rng = np.random.default_rng(42)\n",
        "\n",
        "b = pd.read_csv(os.path.join(BEST_AGG, \"per_seed_summary.csv\"))\n",
        "e = pd.read_csv(os.path.join(E25_AGG, \"per_seed_summary.csv\"))\n",
        "\n",
        "epochs = []\n",
        "for s in b.seed:\n",
        "    p = os.path.join(XRV_SAVE_DIR,\n",
        "                     f\"{HPARAMS2['run_name']}_seed{s}_best_metrics.json\")\n",
        "    epochs.append(json.load(open(p)).get(\"best_epoch\") if os.path.exists(p) else np.nan)\n",
        "b = b.assign(best_epoch=epochs)\n",
        "\n",
        "m = b.merge(e, on=\"seed\", suffixes=('_best', '_e25'))\n",
        "m[\"d_auprc\"] = m.auprc_mean_best - m.auprc_mean_e25\n",
        "m[\"d_point\"] = m.pointing_hit_best - m.pointing_hit_e25\n",
        "m.to_csv(os.path.join(OUT_DIR, \"paired_per_seed.csv\"), index=False)\n",
        "\n",
        "print(\"BEST vs EPOCH25, paired over seeds (EXPLORATORY, §7 out of scope)\")\n",
        "print(m[[\"seed\", \"best_epoch\", \"auprc_mean_best\", \"auprc_mean_e25\", \"d_auprc\",\n",
        "         \"pointing_hit_best\", \"pointing_hit_e25\"]].round(4).to_string(index=False))\n",
        "\n",
        "print(f\"\\n  best epoch: median {np.nanmedian(m.best_epoch):.0f}, \"\n",
        "      f\"range {np.nanmin(m.best_epoch):.0f}-{np.nanmax(m.best_epoch):.0f}\")\n",
        "\n",
        "print(\"\\n\" + \"-\" * 74)\n",
        "print(\"LEVEL: is one checkpoint better on average?\")\n",
        "print(\"-\" * 74)\n",
        "for name, cb, ce in [(\"AUPRC\", \"auprc_mean_best\", \"auprc_mean_e25\"),\n",
        "                     (\"pointing\", \"pointing_hit_best\", \"pointing_hit_e25\")]:\n",
        "    diff = m[cb] - m[ce]\n",
        "    stat, p = wilcoxon(m[cb], m[ce])\n",
        "    boot = np.array([rng.choice(diff.values, len(diff), replace=True).mean()\n",
        "                     for _ in range(N_BOOT)])\n",
        "    lo, hi = np.percentile(boot, [2.5, 97.5])\n",
        "    print(f\"  {name:<9s} best {m[cb].mean():.4f}   ep25 {m[ce].mean():.4f}   \"\n",
        "          f\"diff {diff.mean():+.4f} [{lo:+.4f}, {hi:+.4f}]   \"\n",
        "          f\"Wilcoxon p={p:.4f}\")\n",
        "\n",
        "print(\"\\n\" + \"-\" * 74)\n",
        "print(\"SPREAD: does seed-induced variance differ between checkpoints?\")\n",
        "print(\"-\" * 74)\n",
        "for name, cb, ce in [(\"AUPRC\", \"auprc_mean_best\", \"auprc_mean_e25\"),\n",
        "                     (\"pointing\", \"pointing_hit_best\", \"pointing_hit_e25\")]:\n",
        "    sb, se = m[cb].std(ddof=1), m[ce].std(ddof=1)\n",
        "    boot = np.array([\n",
        "        (pd.Series(rng.choice(m[cb].values, len(m), replace=True)).std(ddof=1)\n",
        "         - pd.Series(rng.choice(m[ce].values, len(m), replace=True)).std(ddof=1))\n",
        "        for _ in range(N_BOOT)])\n",
        "    lo, hi = np.percentile(boot, [2.5, 97.5])\n",
        "    _, p = levene(m[cb], m[ce])\n",
        "    print(f\"  {name:<9s} SD best {sb:.4f}   SD ep25 {se:.4f}   \"\n",
        "          f\"diff {sb - se:+.4f} [{lo:+.4f}, {hi:+.4f}]   Levene p={p:.4f}\")\n",
        "\n",
        "print(\"\\n  If the best-checkpoint SD is larger, part of that is the selection\")\n",
        "print(\"  confound above, not extra seed sensitivity.\")\n",
        "\n",
        "rho_a, p_a = spearmanr(m.auprc_mean_best, m.auprc_mean_e25)\n",
        "rho_p, p_p = spearmanr(m.pointing_hit_best, m.pointing_hit_e25)\n",
        "\n",
        "print(\"\\n\" + \"-\" * 74)\n",
        "print(\"SEED CONSISTENCY: is a 'good' seed good at both checkpoints?\")\n",
        "print(\"-\" * 74)\n",
        "print(f\"  AUPRC    Spearman rho {rho_a:+.4f} (p={p_a:.4f})\")\n",
        "print(f\"  pointing Spearman rho {rho_p:+.4f} (p={p_p:.4f})\")\n",
        "\n",
        "pb = pd.read_csv(os.path.join(BEST_AGG, \"per_image_per_seed_scores.csv\"))\n",
        "pe = pd.read_csv(os.path.join(E25_AGG, \"per_image_per_seed_scores.csv\"))\n",
        "\n",
        "ib = pb.groupby(\"patientId\").auprc.agg([\"mean\", \"std\"])\n",
        "ie = pe.groupby(\"patientId\").auprc.agg([\"mean\", \"std\"])\n",
        "joined = ib.join(ie, lsuffix=\"_best\", rsuffix=\"_e25\", how=\"inner\")\n",
        "joined.to_csv(os.path.join(OUT_DIR, \"paired_per_image.csv\"))\n",
        "\n",
        "rho_m, _ = spearmanr(joined[\"mean_best\"], joined[\"mean_e25\"])\n",
        "rho_s, _ = spearmanr(joined[\"std_best\"], joined[\"std_e25\"])\n",
        "\n",
        "print(\"\\n\" + \"-\" * 74)\n",
        "print(f\"PER-IMAGE ({len(joined)} images)\")\n",
