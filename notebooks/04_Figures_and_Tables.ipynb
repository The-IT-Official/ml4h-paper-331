      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "725e67a5",
      "metadata": {
        "id": "725e67a5"
      },
      "outputs": [],
      "source": [
        "import hashlib\n",
        "\n",
        "CKPT_TAG  = \"epoch25\"\n",
        "FOLDER_M1 = \"grad_vanilla_npy_25\"                       # scorer reads grad_vanilla_npy_25/seed_{S}/{pid}.npy\n",
        "REHEARSAL = True                                # <-- flip to False after HASHES MATCH\n",
        "\n",
        "# determinism is DEFINED in the setup cell but never CALLED in the analysis\n",
        "# path (only train_one_run used to call it), so switch it on explicitly here.\n",
        "set_determinism(42)\n",
        "print(\"deterministic:\", torch.backends.cudnn.deterministic,\n",
        "      \"| benchmark:\", torch.backends.cudnn.benchmark)\n",
        "\n",
        "have = [s for s in HPARAMS2[\"seeds\"]\n",
        "        if os.path.exists(os.path.join(\n",
        "            XRV_SAVE_DIR, f\"{HPARAMS2['run_name']}_seed{s}_{CKPT_TAG}.pth\"))]\n",
        "print(f\"{len(have)}/{len(HPARAMS2['seeds'])} {CKPT_TAG} checkpoints present\")\n",
        "if len(have) < len(HPARAMS2[\"seeds\"]):\n",
        "    print(\"  missing:\", [s for s in HPARAMS2[\"seeds\"] if s not in have])\n",
        "\n",
        "labels_df = pd.read_csv(\"/content/rsna-pneumonia-dataset-npy/stage_2_train_labels.csv\")\n",
        "box_patients = set(labels_df[(labels_df[\"Target\"] == 1) & (labels_df[\"width\"].notna())][\"patientId\"])\n",
        "box_test_df = (test_ds[test_ds[\"patientId\"].isin(box_patients)]\n",
        "               .drop_duplicates(subset=\"patientId\").reset_index(drop=True))\n",
        "print(f\"Box-bearing test patients: {len(box_test_df)}\")\n",
        "\n",
        "\n",
        "def export_grad_for_seed(seed, out_root):\n",
        "    \"\"\"Vanilla gradient: |d logit_pneumonia / d input|, 224x224 float32, one npy per patient.\"\"\"\n",
        "    run_name  = f\"{HPARAMS2['run_name']}_seed{seed}\"\n",
        "    ckpt_path = os.path.join(XRV_SAVE_DIR, f\"{run_name}_{CKPT_TAG}.pth\")\n",
        "    if not os.path.exists(ckpt_path):\n",
        "        print(f\"[seed {seed}] {CKPT_TAG} checkpoint missing, skipping\"); return 0\n",
        "\n",
        "    seed_out = os.path.join(out_root, f\"seed_{seed}\"); os.makedirs(seed_out, exist_ok=True)\n",
        "\n",
        "    model_gc = XRVClassifier(HPARAMS2[\"xrv_weights\"], HPARAMS2[\"dropout\"]).to(device)\n",
        "    missing, unexpected = model_gc.load_state_dict(torch.load(ckpt_path, map_location=\"cpu\"), strict=True)\n",
        "    print(f\"[seed {seed}] strict=True load ({CKPT_TAG})  missing={missing} unexpected={unexpected}\")\n",
        "    model_gc.eval()\n",
        "    for p in model_gc.parameters():            # we want d/d(input), not d/d(weights)\n",
        "        p.requires_grad_(False)\n",
        "\n",
        "    n = 0\n",
        "    preds_rows = []\n",
        "    for _, row in tqdm(box_test_df.iterrows(), total=len(box_test_df), desc=f\"GRAD ep25 seed {seed}\"):\n",
        "        pid = row[\"patientId\"]\n",
        "        if pid not in npy_map:\n",
        "            continue\n",
        "\n",
        "        # ---- identical preprocessing to the Grad-CAM export ----\n",
        "        img_np = np.load(npy_map[pid]).astype(np.float32)\n",
        "        img_np = (img_np - img_np.min()) / (img_np.max() - img_np.min() + 1e-8)\n",
        "        img_np = (img_np * 255.0).clip(0, 255).astype(np.uint8)\n",
        "        img_np = val_transform_xrv(image=img_np)[\"image\"].astype(np.float32)\n",
        "        img_np = xrv.datasets.normalize(img_np, 255)\n",
        "        img_tensor = torch.from_numpy(img_np).unsqueeze(0).unsqueeze(0).float().to(device)\n",
        "\n",
        "        # ---- the M1 part: gradient of the pneumonia logit w.r.t. the image ----\n",
        "        img_tensor.requires_grad_(True)\n",
        "        logits = model_gc(img_tensor)                                   # [1, 2]\n",
        "        prob = torch.softmax(logits.detach().float(), dim=1)[0, 1].item()\n",
        "        model_gc.zero_grad()\n",
        "        logits[0, 1].backward()\n",
        "        grad_map = img_tensor.grad.detach().abs().squeeze().cpu().numpy().astype(np.float32)   # 224x224\n",
        "\n",
        "        np.save(os.path.join(seed_out, f\"{pid}.npy\"), grad_map)\n",
        "        preds_rows.append({\n",
        "            \"seed\": seed,\n",
        "            \"patientId\": pid,\n",
        "            \"true_label\": int(row[\"Target\"]),\n",
        "            \"pred_label\": int(prob >= 0.5),\n",
        "            \"pred_prob\": round(prob, 6),\n",
        "        })\n",
        "        n += 1\n",
        "\n",
        "    # same schema as the Grad-CAM export, so the scorer can read either folder\n",
        "    pd.DataFrame(preds_rows).to_csv(os.path.join(seed_out, \"preds.csv\"), index=False)\n",
        "\n",
        "    del model_gc; torch.cuda.empty_cache()\n",
        "    print(f\"[seed {seed}] {n} GRAD maps -> {seed_out}\")\n",
        "    return n\n",
        "\n",
        "\n",
        "def folder_hash(folder):\n",
        "    \"\"\"SHA-256 over every npy in the folder, sorted by name, so two runs can be compared byte-for-byte.\"\"\"\n",
        "    h = hashlib.sha256()\n",
        "    for f in sorted(os.listdir(folder)):\n",
        "        if f.endswith(\".npy\"):\n",
        "            h.update(f.encode()); h.update(open(os.path.join(folder, f), \"rb\").read())\n",
        "    return h.hexdigest()\n",
        "\n",
        "\n",
        "if REHEARSAL:\n",
        "    # seed 42, twice, two folders, compare\n",
        "    roots = [os.path.join(XRV_SAVE_DIR, f\"{FOLDER_M1}_rehearsal_{k}\") for k in (\"A\", \"B\")]\n",
        "    for r in roots:\n",
        "        os.makedirs(r, exist_ok=True); export_grad_for_seed(42, r)\n",
        "    hA, hB = (folder_hash(os.path.join(r, \"seed_42\")) for r in roots)\n",
        "    print(f\"\\nRun A: {hA}\\nRun B: {hB}\")\n",
        "    print(\"HASHES MATCH -> set REHEARSAL = False and run all 21\" if hA == hB else \"HASHES DIFFER -> STOP, post both hashes in the channel\")\n",
        "else:\n",
        "    out_root = os.path.join(XRV_SAVE_DIR, FOLDER_M1); os.makedirs(out_root, exist_ok=True)\n",
        "    total = sum(export_grad_for_seed(s, out_root) for s in HPARAMS2[\"seeds\"])\n",
        "    print(f\"\\nM1 export complete: {total} maps under {out_root}\")\n",
        "    print(f\"seed_42 hash (should equal the rehearsal): {folder_hash(os.path.join(out_root, 'seed_42'))}\")"
      ]
    },
