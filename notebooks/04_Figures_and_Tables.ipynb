        "class XRVClassifier(nn.Module):\n",
        "    def __init__(self, xrv_weights, dropout, num_classes=2):\n",
        "        super().__init__()\n",
        "        backbone = xrv.models.DenseNet(weights=xrv_weights)\n",
        "        self.features = backbone.features\n",
        "        num_features = backbone.classifier.in_features\n",
        "        self.pool = nn.AdaptiveAvgPool2d(1)\n",
        "        self.classifier = nn.Sequential(\n",
        "            nn.Dropout(dropout),\n",
        "            nn.Linear(num_features, num_classes)\n",
        "        )\n",
        "\n",
        "    def forward(self, x):\n",
        "        feats = self.features(x)\n",
        "        feats = torch.relu(feats)\n",
        "        feats = feats.mean(dim=(2,3))\n",
        "        return self.classifier(feats)\n",
        "\n",
        "\n",
        "# sanity check\n",
        "_sanity_model = XRVClassifier(HPARAMS2[\"xrv_weights\"], HPARAMS2[\"dropout\"]).to(device)\n",
        "_dummy = torch.zeros(2, 1, HPARAMS2[\"img_size\"], HPARAMS2[\"img_size\"]).to(device)\n",
        "with torch.no_grad():\n",
        "    _out = _sanity_model(_dummy)\n",
        "print(\"sanity output shape (must be [2, 2]):\", _out.shape)\n",
        "del _sanity_model, _dummy, _out\n",
        "torch.cuda.empty_cache()"
      ]
    },
