        "ax[0].axhline(CENTRE_B, color=\"#a559aa\", ls=\"--\", lw=1.2,\n",
        "              label=f\"center-Gaussian prior ({CENTRE_B:.3f})\")\n",
        "ax[0].axhline(FLOOR, color=\"#7f7f7f\", ls=\":\", lw=1.2, label=f\"random ({FLOOR:.3f})\")\n",
        "ax[0].set_xticks(x)\n",
