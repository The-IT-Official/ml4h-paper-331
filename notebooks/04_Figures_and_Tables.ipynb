        "# Grad-CAM export loop for BEST checkpoints\n",
        "# Writes to its own folder so the \"best\" export is not overwritten.\n",
        "\n",
        "CKPT_TAG = \"best\"\n",
        "FOLDER_25 = \"gradcam_npy_best_fixedrelu\"\n",
        "CAM_ROOT = os.path.join(XRV_SAVE_DIR, \"gradcam_npy_best_fixedrelu\")\n",
        "\n",
        "labels_df = pd.read_csv(\"/content/rsna-pneumonia-dataset-npy/stage_2_train_labels.csv\")\n",
        "box_patients = set(\n",
        "    labels_df[(labels_df[\"Target\"] == 1) & (labels_df[\"width\"].notna())][\"patientId\"].tolist()\n",
        ")\n",
        "box_test_df = (\n",
        "    test_ds[test_ds[\"patientId\"].isin(box_patients)]\n",
        "    .drop_duplicates(subset=\"patientId\")     # one row per patient, not per box\n",
        "    .reset_index(drop=True)\n",
        ")\n",
        "print(f\"Box-bearing test patients: {len(box_test_df)}\")\n",
        "\n",
        "gradcam_root_25 = os.path.join(XRV_SAVE_DIR, FOLDER_25)\n",
        "os.makedirs(gradcam_root_25, exist_ok=True)\n",
        "print(f\"Root: {gradcam_root_25}\")\n",
        "\n",
        "for seed in HPARAMS2[\"seeds\"]:\n",
        "    run_name = f\"{HPARAMS2['run_name']}_seed{seed}\"\n",
        "    ckpt_path = os.path.join(XRV_SAVE_DIR, f\"{run_name}_{CKPT_TAG}.pth\")\n",
        "\n",
        "    if not os.path.exists(ckpt_path):\n",
        "        print(f\"[seed {seed}] {CKPT_TAG} checkpoint missing, skipping\")\n",
        "        continue\n",
        "\n",
        "    seed_out = os.path.join(gradcam_root_25, f\"seed_{seed}\")\n",
        "    os.makedirs(seed_out, exist_ok=True)\n",
        "\n",
        "    model_gc = XRVClassifier(HPARAMS2[\"xrv_weights\"], HPARAMS2[\"dropout\"]).to(device)\n",
        "    state_dict_gc = torch.load(ckpt_path, map_location=\"cpu\")\n",
        "    missing_keys, unexpected_keys = model_gc.load_state_dict(state_dict_gc, strict=True)\n",
        "    print(f\"[seed {seed}] strict=True load ({CKPT_TAG})\")\n",
        "    print(f\"  missing keys    : {missing_keys}\")\n",
        "    print(f\"  unexpected keys : {unexpected_keys}\")\n",
        "    model_gc.eval()\n",
        "\n",
        "    gradcam_model_gc = GradCAM(model_gc).to(device)\n",
        "    gradcam_model_gc.eval()\n",
        "\n",
        "    preds_rows = []\n",
        "\n",
        "    for _, row in tqdm(box_test_df.iterrows(), total=len(box_test_df),\n",
        "                       desc=f\"GradCAM ep25 seed {seed}\"):\n",
        "        patient_id = row[\"patientId\"]\n",
        "        if patient_id not in npy_map:\n",
        "            continue\n",
        "\n",
        "        img_np = np.load(npy_map[patient_id]).astype(np.float32)\n",
        "        img_np = (img_np - img_np.min()) / (img_np.max() - img_np.min() + 1e-8)\n",
        "        img_np = (img_np * 255.0).clip(0, 255).astype(np.uint8)\n",
        "        img_np = val_transform_xrv(image=img_np)[\"image\"]\n",
        "        img_np = img_np.astype(np.float32)\n",
        "        img_np = xrv.datasets.normalize(img_np, 255)\n",
        "        img_tensor = torch.from_numpy(img_np).unsqueeze(0).unsqueeze(0).float().to(device)\n",
        "\n",
        "        logits = gradcam_model_gc(img_tensor)\n",
        "        prob = torch.softmax(logits.float(), dim=1)[0, 1].item()\n",
        "        pred = int(prob >= 0.5)\n",
        "\n",
        "        gradcam_model_gc.zero_grad()\n",
        "        logits[0, 1].backward()\n",
        "\n",
        "        gradients = gradcam_model_gc.get_activations_gradient()            # [1, C, 7, 7]\n",
        "        pooled_g  = gradients.mean(dim=[0, 2, 3])                          # [C]\n",
        "        activs    = gradcam_model_gc.get_activations(img_tensor).detach()  # [1, C, 7, 7]\n",
        "        weighted  = activs * pooled_g.view(1, -1, 1, 1)\n",
        "        raw_cam   = weighted.mean(dim=1).squeeze().cpu().numpy()           # raw 7x7, no ReLU\n",
        "\n",
        "        np.save(os.path.join(seed_out, f\"{patient_id}.npy\"), raw_cam)\n",
        "\n",
        "        preds_rows.append({\n",
        "            \"seed\": seed,\n",
        "            \"patientId\": patient_id,\n",
        "            \"true_label\": int(row[\"Target\"]),\n",
        "            \"pred_label\": pred,\n",
        "            \"pred_prob\": round(prob, 6),\n",
        "        })\n",
        "\n",
        "    pd.DataFrame(preds_rows).to_csv(os.path.join(seed_out, \"preds.csv\"), index=False)\n",
        "    print(f\"[seed {seed}] {len(preds_rows)} CAMs -> {seed_out}\")\n",
        "\n",
        "    del model_gc, gradcam_model_gc\n",
        "    torch.cuda.empty_cache()\n",
        "\n",
        "print(f\"Grad-CAM export complete ({CKPT_TAG}).\")"
      ]
