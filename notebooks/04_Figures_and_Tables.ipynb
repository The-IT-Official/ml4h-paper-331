        "ax[2].set_xticks(range(len(gaps)))\n",
        "ax[2].set_xticklabels(gaps.keys(), rotation=45, ha=\"right\", fontsize=7)\n",
        "ax[2].set_title(\"6.2 C1: spread vs gaps\"); ax[2].legend(fontsize=8)\n",
