        "def collate_fn(batch):\n",
        "\n",
        "    images = torch.stack(\n",
        "        [x[\"image\"] for x in batch]\n",
        "    )\n",
        "    labels = torch.stack(\n",
        "        [x[\"label\"] for x in batch]\n",
        "    )\n",
        "    bboxes = torch.stack(\n",
        "        [x[\"bbox\"] for x in batch]\n",
        "    )\n",
        "    patient_ids = [\n",
        "        x[\"patient_id\"]\n",
        "        for x in batch\n",
        "    ]\n",
        "    return {\n",
        "        \"images\": images,\n",
        "        \"labels\": labels,\n",
        "        \"bboxes\": bboxes,\n",
        "        \"patient_ids\": patient_ids\n",
        "    }"
      ]
